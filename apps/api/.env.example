# FitFloow API
PORT=4000
HOST=0.0.0.0
MONGO_URI=mongodb://127.0.0.1:27017/fitfloow
# Set MONGO_MEMORY=1 to run against an in-memory MongoDB (development without a local mongod)
MONGO_MEMORY=0
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
VISION_URL=http://127.0.0.1:8100
VISION_MOCK=0
UPLOAD_DIR=./uploads
LOG_LEVEL=info
SEED_ON_BOOT=1
