# apps/vision — every value below is the default; copy to .env only to change something.

# Mock mode: 1 = always deterministic fakes, 0 = require real weights (startup fails without them),
# unset = real model when MODEL_DIR is populated, mock otherwise. `mock` is echoed in every response.
VISION_MOCK=

MODEL_DIR=./models
MODEL_ID=onnx-community/swin-finetuned-food101-ONNX
MODEL_FILE=onnx/model_quantized.onnx
MODEL_REVISION=main

# Open-set gate ("is this food at all?"). Needs `python -m app.download --clip` (+147 MB).
# With the gate on, set INTRA_OP_THREADS=2 — two ORT sessions × 4 threads oversubscribe 4 vCPU.
CLIP_ENABLED=0
CLIP_MODEL_ID=Xenova/clip-vit-base-patch32
CLIP_THRESHOLD=0.6

# Optional Turkish head (prithivMLmods/TurkishFoods-25) — unvetted, off by default.
TURKISH_HEAD=0

TOP_K=3
MIN_CONFIDENCE=0.15
INTRA_OP_THREADS=4
MAX_UPLOAD_MB=6
MAX_IMAGE_SIDE=1024
MAX_CONCURRENCY=2
MAX_QUEUE=8
LOG_LEVEL=info
