# docker compose reads this file as `.env` (copy it: cp .env.example .env) — never commit the real .env.
# Generate every secret with: openssl rand -hex 24   (hex keeps them URL-safe for MONGO_URI)

JWT_SECRET=

# MongoDB (auth is always on). Read only when the mongo-data volume is first created.
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=fitfloow
MONGO_APP_PASSWORD=

# Seed accounts, created on first boot only if set (min 12 chars in production). Clear after first boot.
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
